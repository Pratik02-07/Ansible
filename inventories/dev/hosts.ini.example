# Ansible Inventory — Auto-generated by Terraform
# Teaching inventory: run this FROM the control node.
# The control node manages itself locally and reaches workers by PRIVATE IP.

[all:vars]
ansible_python_interpreter=/usr/bin/python3

[control]
control-node-ubuntu ansible_connection=local ansible_user=ubuntu

[ubuntu_workers]
worker-ubuntu ansible_host=<IP> ansible_user=ubuntu

[redhat]
worker-redhat ansible_host=<IP> ansible_user=ec2-user

[amazon]
worker-amazon ansible_host=<IP> ansible_user=ec2-user

[workers:children]
ubuntu_workers
redhat
amazon

[ubuntu:children]
control
ubuntu_workers